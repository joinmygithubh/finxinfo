# ==============================================================================
# FinXinfo Production Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env on your Hostinger server or set these variables in 
# Hostinger's "Environment Variables" / "Node.js Application Manager" section.

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=production

# On Hostinger, PORT is usually injected automatically by the server runner.
# If manual port binding is required, specify the port assigned by your host.
PORT=5000

# Your live production domain without trailing slash (used for CORS and return URLs)
CLIENT_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Complete MongoDB connection URI with read/write database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finxinfo?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Long, cryptographically random secret string for signing JWT tokens
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_chars

# ------------------------------------------------------------------------------
# 4. Cashfree Payment Gateway (Backend-Exclusive Credentials)
# ------------------------------------------------------------------------------
# Set to PRODUCTION for live transactions or SANDBOX for testing
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# ------------------------------------------------------------------------------
# 5. Email Notification Service (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-account@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=FinXinfo <noreply@yourdomain.com>
ADMIN_EMAIL=contact@yourdomain.com

